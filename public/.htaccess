# =============================================================================
# Smartrepair Reutter — Apache-Konfiguration
# Getestet gegen IONOS Webhosting Plus (Apache, PHP 8.4)
# =============================================================================

# --- HTTPS erzwingen ---------------------------------------------------------
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- Umzug: alte Adressen und kanonischer Host -------------------------------
# NOCH NICHT AKTIV. Zum Scharfschalten die Rautezeichen vor den RewriteCond-
# und RewriteRule-Zeilen entfernen — aber erst, wenn die Domain wirklich auf
# diesen Server zeigt. Vorher sperrt die Regel die Seite aus.
#
# Reihenfolge ist entscheidend: die Zuordnung der alten Adressen steht VOR der
# Kanonisierung und traegt absolute Ziele. Sonst laeuft jede alte Adresse ueber
# zwei Weiterleitungen statt ueber eine, und Google bewertet Ketten schlechter.
#
# Die Zeilen fuer die einzelnen alten Adressen fehlen noch — sie kommen aus dem
# Crawl der alten Seite (siehe docs/umzug.md). Je alte Adresse eine Zeile:
#
#   RewriteRule ^ozonbehandlung\.html$ https://www.smartrepair-reutter.de/leistungen/ozonbehandlung/ [L,R=301]
#
# Nie pauschal auf die Startseite umleiten — das wertet Google als Soft-404 und
# wirft die Platzierung der Einzelseite weg.

# RewriteCond %{HTTP_HOST} !^www\.smartrepair-reutter\.de$ [NC]
# RewriteRule ^ https://www.smartrepair-reutter.de%{REQUEST_URI} [L,R=301]

# --- Konfigurationsdateien nicht ausliefern ----------------------------------
# Apache sperrt von Haus aus nur Dateien, die mit .ht beginnen — .user.ini
# faellt nicht darunter. Da sie eine echte Datei ist, liefert der Server sie
# aus, statt sie an den Front-Controller zu geben. Der Inhalt sind zwei
# Groessenangaben, also nichts Geheimes; Serverkonfiguration gehoert trotzdem
# nicht ins Netz.
#
# Die Fallunterscheidung ist kein Zierrat: Ein blankes „Require" wuerde auf
# Apache 2.2 die gesamte Seite mit einem 500er beantworten. Lieber eine
# ungeschuetzte .user.ini als eine tote Website.
<FilesMatch "^\.user\.ini$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# --- Alles, was keine echte Datei ist, geht an den Front-Controller ----------
# Drei Vorkehrungen, die auf dem eigenen Rechner alle ueberfluessig aussehen
# und auf geteiltem Hosting den Unterschied machen:
#
# RewriteBase / sagt Apache, welcher URL-Pfad zu diesem Verzeichnis gehoert.
# Ohne die Zeile loest ein relatives Ziel wie „index.php" ueber den Dateipfad
# auf. Zeigt eine Domain — wie hier — auf einen Unterordner tief im Webspace,
# entsteht daraus eine Adresse, die es nicht gibt: Apache schreibt erneut um,
# wieder und wieder, und beendet das nach zehn Runden mit einem 500er.
#
# Die Zeile fuer index.php ist die Bremse dahinter: Steht die Anfrage bereits
# auf dem Front-Controller, ist Schluss. Damit kann keine Schleife entstehen,
# selbst wenn die Dateipruefung darunter einmal daneben greift.
#
# Und das Ziel ist /index.php statt index.php — ein URL-Pfad, kein relativer.
# Genau diese Form liefert WordPress seit Jahren aus; sie laeuft auf allem,
# was Apache heisst.
RewriteBase /

RewriteRule ^index\.php$ - [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]

# --- Sicherheits-Header ------------------------------------------------------
<IfModule mod_headers.c>
    # Die Seite laedt ausschliesslich eigene Ressourcen — keine CDN, keine
    # Google Fonts, kein Tracking. Genau das sagt die CSP auch aus.
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), interest-cohort=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# --- In uploads/ wird niemals Code ausgefuehrt -------------------------------
# Die Regeln dafuer stehen in uploads/.htaccess und nicht hier.
#
# Hier standen sie in einem <Directory>-Block, und das war ein Fehler mit
# durchschlagender Wirkung: <Directory> ist ausschliesslich in der
# Serverkonfiguration erlaubt, nicht in einer .htaccess. Apache bricht die
# Datei dann mit „<Directory> not allowed here" ab — und zwar fuer JEDE
# Anfrage, auch fuer die Fehlerseite. Sichtbar wurde das als „Internal Server
# Error", zusaetzlich beim Versuch, das ErrorDocument auszuliefern.
#
# Im selben Block stand „php_flag engine off". Auch das haette 500 ergeben:
# php_flag kennt nur mod_php. IONOS faehrt PHP als CGI/FastCGI, dort ist die
# Anweisung unbekannt.

# --- Caching -----------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    # Assets tragen einen Cache-Buster in der URL, duerfen also lange liegen.
    ExpiresByType text/css                 "access plus 1 year"
    ExpiresByType application/javascript   "access plus 1 year"
    ExpiresByType font/woff2               "access plus 1 year"
    ExpiresByType image/webp               "access plus 6 months"
    ExpiresByType image/svg+xml            "access plus 6 months"
    # HTML nie lange halten, sonst sieht der Kunde seine Aenderungen nicht.
    ExpiresByType text/html                "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# --- Kein Verzeichnislisting -------------------------------------------------
Options -Indexes
