# =============================================================================
# Smartrepair Reutter — Apache-Konfiguration
# Getestet gegen IONOS Webhosting Plus (Apache, PHP 8.4)
# =============================================================================

RewriteEngine On

# --- Umzug: alte Adressen und kanonischer Host -------------------------------
# NOCH NICHT AKTIV. Zum Scharfschalten die Rautezeichen vor den RewriteCond-
# und RewriteRule-Zeilen entfernen — aber erst am Umschalttag, wenn beide
# Domains auf diesen Ordner zeigen. Vorher sperrt die Kanonisierung die Seite
# aus.
#
# Die Liste stammt aus der sitemap.xml der alten Seite (Stand 21.05.2011) plus
# fuenf Adressen, die dort fehlen, weil die Seiten spaeter dazukamen:
# ozonbehandlung, beklebung, gallerie_beklebung, datenschutz und agb.
#
# Diese fuenf tragen die Endung als „(\.html?|\.php)?" statt fest als „.html".
# Grund: Fuer die dreizehn Adressen aus der Sitemap ist die Endung belegt, fuer
# diese fuenf nicht — Google zeigt in den Suchergebnissen nur „… › datenschutz"
# und laesst die Endung weg. Eine Regel, die zu breit greift, kostet nichts:
# Die Namen kommen auf der neuen Website nicht vor. Eine Regel, die wegen einer
# falsch geratenen Endung danebengreift, kostet eine indexierte Seite.
#
# Reihenfolge ist entscheidend: die Zuordnung der alten Adressen steht VOR der
# Kanonisierung und traegt absolute Ziele. Sonst laeuft jede alte Adresse ueber
# zwei Weiterleitungen statt ueber eine, und Google bewertet Ketten schlechter.
#
# Nie pauschal auf die Startseite umleiten — das wertet Google als Soft-404 und
# wirft die Platzierung der Einzelseite weg. Deshalb hat jede Adresse ihr
# eigenes, thematisch passendes Ziel. Eine alte Adresse, die hier fehlt, endet
# bewusst im 404: ehrlicher als ein falsches Ziel, und der Seitenbericht der
# Search Console zeigt sie dann zum Nachtragen.

# Die sechs Leistungsseiten
#RewriteRule ^fahrzeugpflege_exterieur\.html$            https://www.smartrepair-reutter.de/leistungen/fahrzeugpflege-exterieur/ [L,R=301]
#RewriteRule ^fahrzeugpflege_interieur\.html$            https://www.smartrepair-reutter.de/leistungen/fahrzeugpflege-interieur/ [L,R=301]
#RewriteRule ^lackierarbeiten\.html$                     https://www.smartrepair-reutter.de/leistungen/lackierarbeiten/ [L,R=301]
#RewriteRule ^dellenbeseitigung_hagelschaden\.html$      https://www.smartrepair-reutter.de/leistungen/dellen-hagelschaden/ [L,R=301]
#RewriteRule ^lederreparatur\.html$                      https://www.smartrepair-reutter.de/leistungen/lederreparatur/ [L,R=301]
#RewriteRule ^ozonbehandlung(\.html?|\.php)?$            https://www.smartrepair-reutter.de/leistungen/ozonbehandlung/ [L,R=301]

# Beklebung war nie eine eigene Seite, sondern ein Abschnitt der
# Lackierarbeiten. [NE] ist hier noetig, sonst macht Apache aus dem # ein %23
# und die Sprungmarke greift nicht.
#RewriteRule ^beklebung(\.html?|\.php)?$                 https://www.smartrepair-reutter.de/leistungen/lackierarbeiten/#beklebung [L,NE,R=301]
#RewriteRule ^gallerie_beklebung(\.html?|\.php)?$        https://www.smartrepair-reutter.de/leistungen/lackierarbeiten/#beklebung [L,NE,R=301]

# Die alte Galerie war nach Leistung aufgeteilt. Die neue filtert im Browser,
# nicht ueber die Adresse — alle fuenf landen deshalb auf derselben Seite.
# Thematisch richtig und allemal besser als ein 404.
#RewriteRule ^gallerie\.html$                            https://www.smartrepair-reutter.de/galerie/ [L,R=301]
#RewriteRule ^gallerie_exterieur\.html$                  https://www.smartrepair-reutter.de/galerie/ [L,R=301]
#RewriteRule ^gallerie_interieur\.html$                  https://www.smartrepair-reutter.de/galerie/ [L,R=301]
#RewriteRule ^gallerie_dellenbeseitigung_hagelschaden\.html$ https://www.smartrepair-reutter.de/galerie/ [L,R=301]
#RewriteRule ^gallerie_lederreparatur\.html$             https://www.smartrepair-reutter.de/galerie/ [L,R=301]

# Kontakt und Impressum
#RewriteRule ^kontakt_und_anfahrt\.html$                 https://www.smartrepair-reutter.de/kontakt/ [L,R=301]
#RewriteRule ^impressum\.html$                           https://www.smartrepair-reutter.de/impressum/ [L,R=301]

# Datenschutz und AGB. Beide stehen weder in der Sitemap von 2011 noch waren
# sie sonst bekannt — sie kamen erst spaeter dazu (die AGB tragen im Google-
# Auszug den 13.06.2018). Gefunden ueber eine Suche nach „site:clean-box.eu",
# also genau der Weg, den docs/umzug.md dafuer beschreibt.
#
# Waeren sie hier nicht aufgefuehrt, liefe ausgerechnet die Datenschutz-
# erklaerung der alten Seite auf einen 404 — eine Adresse, die aus jedem
# Impressum und jedem Formular verlinkt war.
#RewriteRule ^datenschutz(\.html?|\.php)?$               https://www.smartrepair-reutter.de/datenschutz/ [L,R=301]
#RewriteRule ^agb(\.html?|\.php)?$                       https://www.smartrepair-reutter.de/agb/ [L,R=301]

# Die alte Startseite lag unter /index.php. Die Bedingung darueber ist kein
# Zierrat: Ohne sie trifft diese Regel auch jeden internen Umschrieb des
# Front-Controllers — der endet ja ebenfalls auf index.php — und jede einzelne
# Seite der neuen Website liefe in eine Weiterleitungsschleife.
# REDIRECT_STATUS ist beim ersten Aufruf leer und danach gesetzt.
#RewriteCond %{ENV:REDIRECT_STATUS} ^$
#RewriteRule ^index\.php$                                https://www.smartrepair-reutter.de/ [L,R=301]

# Zum Schluss: alles, was nicht schon oben abgebogen ist, auf den kanonischen
# Host. Das faengt auch die alte Startseite ab.
#RewriteCond %{HTTP_HOST} !^www\.smartrepair-reutter\.de$ [NC]
#RewriteRule ^ https://www.smartrepair-reutter.de%{REQUEST_URI} [L,R=301]

# --- HTTPS erzwingen ---------------------------------------------------------
# Steht bewusst NACH dem Umzugsblock, nicht davor. Die Reihenfolge entscheidet
# darueber, ob eine alte Adresse ueber einen oder ueber zwei Spruenge ans Ziel
# kommt — und sie betrifft nicht ein paar Randfaelle, sondern praktisch jeden
# Besucher, der von aussen kommt: Die alte Seite laeuft nur ueber http, also
# lauten auch alle Adressen im Google-Index und in fremden Links „http://".
#
# Stuende diese Regel oben, griffe sie zuerst und machte aus
#   http://www.clean-box.eu/ozonbehandlung.html
# erst  https://www.clean-box.eu/ozonbehandlung.html  (Sprung 1, ohne Nutzen)
# und daraus https://www.smartrepair-reutter.de/leistungen/ozonbehandlung/
# (Sprung 2). Die Umzugsregeln tragen ihre Ziele bereits mit https, der Umweg
# ist also reine Verschwendung. Google bewertet Ketten schlechter als einen
# einzelnen Sprung, und jeder Sprung kostet den Besucher eine Rundreise.
#
# Ein Loch entsteht durch die neue Reihenfolge nicht: Was keine Umzugsregel
# trifft, faellt hier herunter und wird weiterhin auf https gezwungen.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- Konfigurationsdateien nicht ausliefern ----------------------------------
# Apache sperrt von Haus aus nur Dateien, die mit .ht beginnen — .user.ini
# faellt nicht darunter. Da sie eine echte Datei ist, liefert der Server sie
# aus, statt sie an den Front-Controller zu geben. Der Inhalt sind zwei
# Groessenangaben, also nichts Geheimes; Serverkonfiguration gehoert trotzdem
# nicht ins Netz.
#
# Die Fallunterscheidung ist kein Zierrat: Ein blankes „Require" wuerde auf
# Apache 2.2 die gesamte Seite mit einem 500er beantworten. Lieber eine
# ungeschuetzte .user.ini als eine tote Website.
<FilesMatch "^\.user\.ini$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# --- Alles, was keine echte Datei ist, geht an den Front-Controller ----------
# Drei Vorkehrungen, die auf dem eigenen Rechner alle ueberfluessig aussehen
# und auf geteiltem Hosting den Unterschied machen:
#
# RewriteBase / sagt Apache, welcher URL-Pfad zu diesem Verzeichnis gehoert.
# Ohne die Zeile loest ein relatives Ziel wie „index.php" ueber den Dateipfad
# auf. Zeigt eine Domain — wie hier — auf einen Unterordner tief im Webspace,
# entsteht daraus eine Adresse, die es nicht gibt: Apache schreibt erneut um,
# wieder und wieder, und beendet das nach zehn Runden mit einem 500er.
#
# Die Zeile fuer index.php ist die Bremse dahinter: Steht die Anfrage bereits
# auf dem Front-Controller, ist Schluss. Damit kann keine Schleife entstehen,
# selbst wenn die Dateipruefung darunter einmal daneben greift.
#
# Und das Ziel ist /index.php statt index.php — ein URL-Pfad, kein relativer.
# Genau diese Form liefert WordPress seit Jahren aus; sie laeuft auf allem,
# was Apache heisst.
RewriteBase /

RewriteRule ^index\.php$ - [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]

# --- Sicherheits-Header ------------------------------------------------------
<IfModule mod_headers.c>
    # Die Seite laedt ausschliesslich eigene Ressourcen — keine CDN, keine
    # Google Fonts, kein Tracking. Genau das sagt die CSP auch aus.
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), interest-cohort=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# --- In uploads/ wird niemals Code ausgefuehrt -------------------------------
# Die Regeln dafuer stehen in uploads/.htaccess und nicht hier.
#
# Hier standen sie in einem <Directory>-Block, und das war ein Fehler mit
# durchschlagender Wirkung: <Directory> ist ausschliesslich in der
# Serverkonfiguration erlaubt, nicht in einer .htaccess. Apache bricht die
# Datei dann mit „<Directory> not allowed here" ab — und zwar fuer JEDE
# Anfrage, auch fuer die Fehlerseite. Sichtbar wurde das als „Internal Server
# Error", zusaetzlich beim Versuch, das ErrorDocument auszuliefern.
#
# Im selben Block stand „php_flag engine off". Auch das haette 500 ergeben:
# php_flag kennt nur mod_php. IONOS faehrt PHP als CGI/FastCGI, dort ist die
# Anweisung unbekannt.

# --- Caching -----------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    # Assets tragen einen Cache-Buster in der URL, duerfen also lange liegen.
    ExpiresByType text/css                 "access plus 1 year"
    ExpiresByType application/javascript   "access plus 1 year"
    ExpiresByType font/woff2               "access plus 1 year"
    ExpiresByType image/webp               "access plus 6 months"
    ExpiresByType image/svg+xml            "access plus 6 months"
    # HTML nie lange halten, sonst sieht der Kunde seine Aenderungen nicht.
    ExpiresByType text/html                "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# --- Kein Verzeichnislisting -------------------------------------------------
Options -Indexes
